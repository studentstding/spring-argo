# Plik w katalogu głównym: dotyczy całego projektu
config.stopBubbling = true

# @RequiredArgsConstructor ma przenosić @Value z pola na parametr konstruktora,
# inaczej Spring nie wiedziałby, jaką wartość wstrzyknąć (patrz GreetingService)
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value

# Oznacza wygenerowany kod adnotacją @Generated (np. pomijany w raportach pokrycia testów)
lombok.addLombokGeneratedAnnotation = true
